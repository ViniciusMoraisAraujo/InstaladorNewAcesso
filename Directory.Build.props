<Project>

  <!-- ════════════════════════════════════════════════
       Directory.Build.props – InstaladorNewAcesso
       Propriedades compartilhadas entre todos os projetos
       ════════════════════════════════════════════════ -->

  <PropertyGroup>
    <!-- .NET target padrão (WinForms sobrescreve no próprio csproj) -->
    <TargetFramework>net10.0</TargetFramework>

    <!-- Nullable reference types (todos os projetos) -->
    <Nullable>enable</Nullable>

    <!-- Usings implícitos (System, System.Collections.Generic, etc.) -->
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Ícone personalizado compartilhado entre todos os projetos EXE -->
    <ApplicationIcon>$(MSBuildThisFileDirectory)src\app.ico</ApplicationIcon>

    <!--
      Nível de análise: latest-Recommended ativa as regras padrão do .NET.
      NOTA: Evite AnalysisMode=AllEnabledByDefault — ativa centenas de regras
      desabilitadas por padrão, gerando warnings em excesso.
    -->
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Build determinístico -->
    <Deterministic>true</Deterministic>

    <!-- Acelera builds no Visual Studio -->
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>

    <!--
      Suprime warnings de platform-specific (Registry, IIS = Windows-only).
      O InstaladorNewAcesso é exclusivamente Windows.
    -->
    <NoWarn>$(NoWarn);CA1416;CA1422</NoWarn>
  </PropertyGroup>

  <!-- Regras herdadas de Debug/Release -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- ════════════════════════════════════════════════
       Configurações de publicação (dotnet publish / PublishSingleFile)
       ════════════════════════════════════════════════ -->
  <PropertyGroup Condition="'$(OutputType)' == 'Exe' Or '$(OutputType)' == 'WinExe'">
    <!-- Publica como único arquivo .exe (apenas em dotnet publish) -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Inclui bibliotecas nativas no single file (auto-extração) -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!--
      SelfContained=true: inclui o runtime .NET (não precisa instalar na máquina alvo).
      SelfContained=false (framework-dependent): requer .NET 10 instalado, mas o EXE é ~5 MB.
      Para desabilitar: dotnet publish -p:SelfContained=false
    -->
    <SelfContained>true</SelfContained>
  </PropertyGroup>

</Project>
